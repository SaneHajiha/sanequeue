[Unit]
Description=SaneQueue contact-center dashboard
After=network.target

[Service]
User=sanequeue
Group=sanequeue
WorkingDirectory=/opt/sanequeue
Environment=QPANEL_CONFIG_FILE=/etc/sanequeue/config.ini
Environment=TZ=Asia/Tehran
Environment=SANEQUEUE_RUNTIME=server
Environment=SANEQUEUE_STATE_DIR=/var/lib/sanequeue
Environment=SANEQUEUE_DEMO_PORT=5000
ExecStart=/opt/sanequeue/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:5000 --timeout 45 --access-logfile - qpanel.wsgi:app
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/sanequeue

[Install]
WantedBy=multi-user.target
