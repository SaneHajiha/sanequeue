[Unit]
Description=SaneQueue Redis-backed HTTP and WebSocket gateway
After=network.target sanequeue-collector.service

[Service]
User=sanequeue
Group=sanequeue
SupplementaryGroups=asterisk
WorkingDirectory=/opt/sanequeue
Environment=QPANEL_CONFIG_FILE=/etc/sanequeue/config.ini
Environment=SANEQUEUE_RUNTIME=server
Environment=SANEQUEUE_STATE_DIR=/var/lib/sanequeue
Environment=SANEQUEUE_COLLECTOR_CONFIG=/etc/sanequeue/collector.ini
Environment=SANEQUEUE_CONTROL_CONFIG=/etc/sanequeue/control.ini
EnvironmentFile=/etc/sanequeue/gateway.env
EnvironmentFile=-/etc/sanequeue/reporting-web.env
ExecStart=/opt/sanequeue/.venv/bin/uvicorn sanequeue.asgi:app --host 127.0.0.1 --port 5000 --workers 1 --ws-max-size 16384 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sanequeue -/var/spool/asterisk/sanequeue

[Install]
WantedBy=multi-user.target
