# Replace with the exact browser origin; TLS is configured at the reverse proxy.
SANEQUEUE_PUBLIC_ORIGINS=https://queues.example.com
SANEQUEUE_HTTPS=1
# Optional supervisor actions are disabled unless explicitly listed.
SANEQUEUE_ADVANCED_ACTIONS=transfer,attended_transfer,cancel_transfer,park,retrieve,pickup,dial,hangup_active
SANEQUEUE_INTERNAL_EXTENSIONS=100,200,300
SANEQUEUE_TRANSFER_CONTEXT=from-internal
SANEQUEUE_PARKING_LOT=default
