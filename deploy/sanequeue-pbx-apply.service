[Unit]
Description=SaneQueue typed telephone configuration adapter
After=asterisk.service sanequeue-inventory.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sanequeue
ExecStart=/opt/sanequeue/.venv/bin/python -m sanequeue.pbx.root_adapter
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/asterisk /var/backups/sanequeue /var/spool/asterisk /var/lib/asterisk/sounds/custom /run/sanequeue
TimeoutStartSec=25
TimeoutStopSec=10
