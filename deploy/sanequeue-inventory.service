[Unit]
ConditionPathExists=!/var/lib/sanequeue/module.disabled
Description=SaneQueue local redacted PBX inventory
After=asterisk.service

[Service]
Type=oneshot
User=root
Group=sanequeue
WorkingDirectory=/opt/sanequeue
ExecStart=/opt/sanequeue/.venv/bin/python -m sanequeue.realtime.local_inventory
RuntimeDirectory=sanequeue
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/sanequeue
TimeoutStartSec=20
TimeoutStopSec=10
